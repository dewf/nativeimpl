name "testlibraryclient"
description "NativeImpl Test Library (Client)"
authors "Daniel X"
copyright "Copyright © 2021, Daniel X"
license "MIT"
targetType "library"
targetPath "$PACKAGE_DIR/lib"

configuration "win32-config-64" {
	platforms "windows-x86_64"
	targetType "library"
	libs "$PACKAGE_DIR/../../libraryproject_cpp/x64/Debug/TestLibrary"
}
configuration "win32-config-32" {
	platforms "windows-x86_mscoff"
	targetType "library"
	libs "$PACKAGE_DIR/../../libraryproject_cpp/Debug/TestLibrary"
}
