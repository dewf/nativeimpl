<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>default</LangVersion>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>nativeimpl</ToolCommandName>

        <PackageId>NativeImpl</PackageId>
        <!-- <Version>0.5.0</Version> -->
        <Authors>dewf</Authors>
        <Description>Language-agnostic native bindings generator</Description>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/dewf/nativeimpl</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="\" />
        <Compile Include="Extensions.fs" />
        <Compile Include="Util.fs" />
        <Compile Include="Tokenizer.fs" />
        <Compile Include="ParseCommon.fs" />
        <Compile Include="ConstParser.fs" />
        <Compile Include="Parser.fs" />
        <Compile Include="AppCommon.fs" />
        <Compile Include="SupportCopier.fs" />
        <Compile Include="Generators\Common.fs" />
        <Compile Include="Generators\Frontend\CsharpGenerator.fs" />
        <Compile Include="Generators\Frontend\DlangGenerator.fs" />
        <Compile Include="Generators\Backend\CppGenerator.fs" />
        <Compile Include="DynlibGenerator.fs" />
        <Compile Include="ProjectParser.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="support-files\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Argu" Version="6.2.5" />
      <PackageReference Include="Tomlyn" Version="1.1.1" />
    </ItemGroup>

</Project>
