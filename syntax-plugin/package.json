{
  "name": "nativeimpl-syntax",
  "displayName": "NativeImpl Syntax",
  "description": "NativeImpl syntax highlighter",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "nativeimpl",
      "aliases": ["NativeImpl", "nativeimpl"],
      "extensions": [".ni"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "nativeimpl",
      "scopeName": "source.nativeimpl",
      "path": "./syntaxes/nativeimpl.tmLanguage.json"
    }]
  }
}
